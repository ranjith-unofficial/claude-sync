{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Library/Mobile Documents/com~apple~CloudDocs/ClaudeSync/bin/claude-sync-guard.sh\"",
            "timeout": 20,
            "statusMessage": "Syncing Claude memory\u2026"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/Library/Mobile Documents/com~apple~CloudDocs/ClaudeSync/bin/claude-sync-backup.sh\"",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "autoUploadSessions": false
}
